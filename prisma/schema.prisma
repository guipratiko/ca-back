generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String        @db.Text
  coverImage     String?
  category       String
  author         String        @default("Equipe CA Cursos")
  glyph          String        @default("📝")
  featured       Boolean       @default(false)
  readingTime    Int           @default(5)
  seoTitle       String?
  seoDescription String?
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
  @@index([category])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  price       Float
  compareAt   Float?
  image       String?
  images      String[]      @default([])
  category    String        @default("Geral")
  categoryId  String?
  categoryRef Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured    Boolean       @default(false)
  status      ArticleStatus @default(DRAFT)
  buttonLabel String        @default("Quero este produto")
  buttonUrl   String?
  reference   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, featured])
  @@index([slug])
  @@index([category])
  @@index([categoryId])
  @@index([reference])
  @@index([price])
}

/** Vídeo aulas abertas (gratuitas) do site */
model OpenLesson {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String        @db.Text
  youtubeId   String
  category    String
  duration    String        @default("")
  views       String        @default("")
  sortOrder   Int           @default(0)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([slug])
  @@index([category])
}

/** Catálogo de cursos do site */
model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  category    String
  level       String        @default("Iniciante")
  glyph       String        @default("📱")
  badge       String?
  featured    Boolean       @default(false)
  hours       Int           @default(0)
  lessons     Int           @default(0)
  students    Int           @default(0)
  rating      Float         @default(0)
  reviews     Int           @default(0)
  format      String        @default("")
  access      String?
  price       Float
  compareAt   Float?
  installments String?
  boleto      String?
  deposit     String?
  priceNote   String?
  link        String?
  summary     String        @db.Text
  forWho      Json          @default("[]")
  learns      Json          @default("[]")
  benefits    Json          @default("[]")
  classes     Json          @default("[]")
  modules     Json          @default("[]")
  faq         Json          @default("[]")
  sortOrder   Int           @default(0)
  status      ArticleStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, featured, sortOrder])
  @@index([slug])
  @@index([category])
  @@index([price])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}
